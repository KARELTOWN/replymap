# Modèle de configuration : aucune valeur réelle ici.
#
# Le fichier utilisable est produit par le coffre chiffré :
#   npm run secrets -- decrypt local
#
# Et toute modification y retourne :
#   npm run secrets -- set local CLE=valeur
#

PORT =
HOST=

RECORD_HOST=
RECORD_PORT=

REDIS_HOST=
REDIS_PORT=
REDIS_DEFAULT_CACHE_EXPIRATION=

DB_PASSWORD=
DB_USER=
DB_CLUSTER_URL=
DB_CLUSTER=
ENVIRONMENT=
SOCKET_URL=

# MAIL_HOST=
# MAIL_PORT=
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=

MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

FRONT_URL=
# Doit être une URL publiquement joignable pour que le webhook Trello fonctionne
# (localhost ne l'est pas : utiliser un tunnel type ngrok pour tester en local)
BACKEND_URL=


SECRET_KEY=

# Cloudflare R2 (S3 API). R2_REGION defaults to "auto".
# R2_PUBLIC_URL is optional: set it only to serve files through a public
# bucket domain; without it, files stay private and are read through
# signed links valid one hour.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PUBLIC_URL=

encrypted_key_hash=
iv_key_hash=

ELASTIC_URL=
ELASTIC_API_KEY=

# Origines autorisées à porter des identifiants (tableau de bord, SSO, widget)
APP_ORIGINS=

# Intégration Trello (anciennement en dur dans utils/keys.js — à faire tourner)
TRELLO_API_KEY=
TRELLO_SECRET=

# Parent domain of the session cookies outside local (e.g. .bugreveal.com),
# shared by the dashboard, the SSO window and the API.
COOKIE_DOMAIN=
